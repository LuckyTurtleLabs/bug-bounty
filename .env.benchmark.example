# Copy to .env.benchmark. Existing environment variables take precedence.
# Use a disposable local/staging server: the suite sends writes and payments.
BENCHMARK_BASE_URL=http://127.0.0.1:4000
# Dedicated test-user bearer token; never a production credential.
BENCHMARK_TOKEN=
BENCHMARK_CONCURRENCY=10
BENCHMARK_REQUESTS=100
BENCHMARK_WARMUP=5
BENCHMARK_TIMEOUT_MS=5000
